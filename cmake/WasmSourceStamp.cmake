execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_ROOT}" rev-parse HEAD
    RESULT_VARIABLE commitResult OUTPUT_VARIABLE sourceCommit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
string(LENGTH "${sourceCommit}" commitLength)
if(NOT commitResult EQUAL 0 OR NOT commitLength EQUAL 40 OR NOT sourceCommit MATCHES "^[0-9a-f]+$")
    set(sourceCommit "")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_ROOT}" status --porcelain --ignore-submodules=all -- core/relinker CMakeLists.txt cmake
    RESULT_VARIABLE dirtyResult OUTPUT_VARIABLE sourceStatus ERROR_QUIET)
if(NOT dirtyResult EQUAL 0)
    set(sourceDirty -1)
elseif(sourceStatus STREQUAL "")
    set(sourceDirty 0)
else()
    set(sourceDirty 1)
endif()
set(content "#pragma once\n#define ANYPS5_WASM_SOURCE_COMMIT \"${sourceCommit}\"\n#define ANYPS5_WASM_SOURCE_DIRTY ${sourceDirty}\n")
if(EXISTS "${STAMP_PATH}")
    file(READ "${STAMP_PATH}" previous)
else()
    set(previous "")
endif()
if(NOT previous STREQUAL content)
    file(WRITE "${STAMP_PATH}" "${content}")
endif()
